<Window x:Class="AIHub.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIHub.Windows"
        Title="AIHub" Height="860" Width="1380" MinHeight="640" MinWidth="980"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_OnSizeChanged"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AIHub" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="  七模型工作台" Foreground="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ProviderStrip" Orientation="Horizontal"
                                HorizontalAlignment="Right"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="286"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DrawerSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="DrawerColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ConversationSearch" Margin="12,12,12,6" Height="38"
                             Padding="12,8" FontSize="13"
                             ToolTip="搜索会话（Ctrl+K）"
                             TextChanged="ConversationSearch_OnTextChanged"/>
                    <Button Grid.Row="1" Content="+ 新建当前模型会话" Margin="12,4,12,8"
                            Click="NewCurrentConversation_OnClick"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ConversationGroups"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ProviderBadge" CornerRadius="13" Padding="10,5">
                                <TextBlock x:Name="ProviderBadgeText" Foreground="#09120D"
                                           FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="ConversationTitle" Margin="12,0,0,0"
                                       FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="GenerationState" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="重命名" Click="RenameConversation_OnClick"/>
                            <Button Content="置顶" Click="PinConversation_OnClick"/>
                            <Button Content="官网" Click="ToggleDrawer_OnClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MessageScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              ScrollChanged="MessageScroller_OnScrollChanged">
                    <ItemsControl x:Name="MessageList" Margin="24,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,7" Padding="18,15" CornerRadius="14"
                                        Background="{Binding Background}"
                                        HorizontalAlignment="{Binding Alignment}"
                                        MinWidth="190" MaxWidth="780">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Author}"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="复制" Padding="7,3"
                                                        Tag="{Binding}" Click="CopyMessage_OnClick"/>
                                                <Button x:Name="RetryButton" Content="重试" Padding="7,3"
                                                        Tag="{Binding}" Click="RetryMessage_OnClick"/>
                                                <Button x:Name="EditButton" Content="编辑" Padding="7,3"
                                                        Tag="{Binding}" Click="EditMessage_OnClick"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,7,0,0">
                                            <TextBlock x:Name="PlainMessage" Text="{Binding Text}"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       TextWrapping="Wrap" FontSize="16.5" LineHeight="27"
                                                       FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"/>
                                            <local:MarkdownViewer x:Name="MarkdownMessage"
                                                                  Markdown="{Binding Text}"
                                                                  Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Text="{Binding StatusLabel}" Margin="0,7,0,0"
                                                   Foreground="#E4A675" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMarkdown}" Value="True">
                                        <Setter TargetName="PlainMessage" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="MarkdownMessage" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="RetryButton" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="24,8,24,20"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>
                        <WrapPanel x:Name="AttachmentPanel" Margin="10,8,10,0"/>
                        <TextBox x:Name="ComposerBox" Grid.Row="1" MinHeight="76" MaxHeight="190"
                                 AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                                 Padding="15" FontSize="15" VerticalScrollBarVisibility="Auto"
                                 TextChanged="ComposerBox_OnTextChanged"
                                 KeyDown="ComposerBox_OnKeyDown"/>
                        <Grid Grid.Row="2" Margin="10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AttachButton" Content="＋ 附件"
                                        Click="AttachButton_OnClick" Visibility="Collapsed"/>
                                <ItemsControl x:Name="CapabilityBar">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="StopButton" Content="停止" Visibility="Collapsed"
                                        Click="StopButton_OnClick"/>
                                <Button x:Name="SendButton" Content="发送"
                                        Background="{DynamicResource SuccessBrush}" Foreground="#08100C"
                                        FontWeight="Bold" Click="SendButton_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>
            <Border Grid.Column="3" x:Name="ProviderWebDrawer"
                    Background="White" Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Background="{DynamicResource PanelBackground}">
                        <TextBlock x:Name="DrawerTitle" Margin="14,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button Content="关闭" HorizontalAlignment="Right"
                                Click="ToggleDrawer_OnClick"/>
                    </Grid>
                    <Grid x:Name="BrowserHost" Grid.Row="1" Background="White"/>
                </Grid>
            </Border>

            <Border x:Name="ToastHost" Grid.ColumnSpan="4" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="24" Padding="14,9"
                    Background="#E6322530" CornerRadius="9" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" Foreground="White" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
