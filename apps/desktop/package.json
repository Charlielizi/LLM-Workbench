{
  "name": "@aihub/desktop",
  "version": "0.1.0-rc.1",
  "private": true,
  "author": "AIHub contributors",
  "description": "Unified local desktop client for provider websites",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge make --platform win32",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:ai:e2e": "playwright test --config playwright.config.ts",
    "test:ai:e2e:update": "playwright test --config playwright.config.ts --update-snapshots"
  },
  "dependencies": {
    "@aihub/adapters": "workspace:*",
    "@aihub/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.1",
    "electron-squirrel-startup": "^1.0.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@playwright/test": "^1.61.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^42.5.0",
    "vite": "^6.3.5"
  }
}
